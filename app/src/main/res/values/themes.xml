<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AlarmClock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_header</item>
        <item name="android:navigationBarColor">@color/bottom_nav_bg</item>
    </style>

    <style name="Theme.AlarmClock" parent="Base.Theme.AlarmClock" />

    <!-- Splash Screen Theme -->
    <style name="Theme.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">#3B47D4</item>
        <item name="android:navigationBarColor">#1A1F6E</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="CustomNumberPickerTheme" parent="Theme.Material3.DayNight">
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:colorControlNormal">@color/divider_color</item>
    </style>
</resources>