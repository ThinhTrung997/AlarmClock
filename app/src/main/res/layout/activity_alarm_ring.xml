<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_ring">

    <!-- Center Content: Icon + Time + Label -->
    <LinearLayout
        android:id="@+id/layoutCenterContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Alarm Bell Icon -->
        <ImageView
            android:id="@+id/ivAlarmIcon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/icon_alarm"
            app:tint="#C0C1FF"
            android:contentDescription="Alarm Icon" />

        <!-- Large Time Text -->
        <TextView
            android:id="@+id/tvRingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="07:30"
            android:textColor="#FFFFFF"
            android:textSize="58sp"
            android:textStyle="bold" />

        <!-- Alarm Title / Label -->
        <TextView
            android:id="@+id/tvRingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/tab_alarm"
            tools:text="Morning Workout"
            android:textColor="#C7C4D7"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Buttons (Snooze & Dismiss) -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Snooze Pill Button -->
        <LinearLayout
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_snooze"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_snooze"
                app:tint="#FFFFFF"
                android:contentDescription="Snooze" />

            <TextView
                android:id="@+id/tvSnoozeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/snooze_button_text"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Dismiss Pill Button -->
        <LinearLayout
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_dismiss"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_close"
                app:tint="#0D0096"
                android:contentDescription="Dismiss" />

            <TextView
                android:id="@+id/tvDismissText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/dismiss_button_text"
                android:textColor="#0D0096"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
