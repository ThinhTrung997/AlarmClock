<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Decorative circle glow (top) -->
    <View
        android:id="@+id/glowCircleTop"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:alpha="0.08"
        android:background="@drawable/bg_glow_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="-80dp"/>

    <!-- Decorative circle glow (bottom) -->

    <!-- Center content group -->

    <View
        android:id="@+id/glowCircleBottom"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginStart="-60dp"
        android:layout_marginBottom="-60dp"
        android:alpha="0.06"
        android:background="@drawable/bg_glow_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/centerGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo circle background -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <!-- Circle glow -->
            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:alpha="0.3"
                android:background="@drawable/bg_splash_logo_glow" />

            <!-- Logo icon -->
            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:src="@drawable/ic_splash_logo"
                android:contentDescription="AlarmClock Logo" />
        </FrameLayout>

        <!-- App name -->
        <TextView
            android:id="@+id/tvSplashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="AlarmClock"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif-medium" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Never miss a moment"
            android:textColor="#AABFFF"
            android:textSize="15sp"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- Loading dots at bottom -->
    <LinearLayout
        android:id="@+id/loadingDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="80dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_splash_dot"
            android:alpha="1.0"/>

        <View
            android:id="@+id/dot2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_splash_dot"
            android:alpha="0.4"/>

        <View
            android:id="@+id/dot3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_splash_dot"
            android:alpha="0.4"/>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
